# Deny direct access to all files in uploads directory
# Files should only be served through the MVC route /uploads/{scope}/{id}/{filename}
# which validates access permissions

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Prevent execution of PHP scripts
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory listing
Options -Indexes

# Optional: Allow specific image types if you want to serve some directly
# (not recommended - all access should go through MVC)
# <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg)$">
#     <IfModule mod_authz_core.c>
#         Require all granted
#     </IfModule>
# </FilesMatch>