# IDE
.idea/

# Системный мусор
Thumbs.db
.DS_Store
desktop.ini

# Временные и runtime-файлы (резервные копии шаблонов, логи)
/var/
*.log

# Пользовательские загрузки — контент не версионируем, .htaccess сохраняем
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/profile/

# Примечание: config/database.php содержит пароль БД. Файл уже попадал
