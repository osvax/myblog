# Временные и runtime-файлы (резервные копии шаблонов, логи); .htaccess оставляем
/var/*
!/var/.htaccess

# Пользовательские загрузки — контент не версионируем, .htaccess сохраняем
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/profile/
/public/uploads/profile/*
!/public/uploads/profile/.htaccess
!/public/uploads/custom/
/public/uploads/custom/*
!/public/uploads/custom/.htaccess
!/public/uploads/blog/
/public/uploads/blog/*
!/public/uploads/blog/.htaccess
!/public/uploads/images/
/public/uploads/images/*
!/public/uploads/images/.htaccess
!/public/uploads/documents/
/public/uploads/documents/*
!/public/uploads/documents/.htaccess
!/public/uploads/portfolio/
/public/uploads/portfolio/*
!/public/uploads/portfolio/.htaccess

