# MyBlog Environment Configuration
# Copy to .env and adjust values

APP_ENV=production
APP_DEBUG=false
APP_URL=http://myblog.loc

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myblog
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=va_

# Redis (for rate limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Mail (SMTP)
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=no-reply@myblog.loc
SMTP_FROM_NAME=МойБлог
SMTP_REPLY_TO=

# PHP mail() fallback (when SMTP disabled)
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@myblog.loc
MAIL_FROM_NAME=МойБлог

# Security
APP_KEY=your-32-char-secret-key-here
CSRF_TOKEN_LIFETIME=7200

# Session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Logging
LOG_CHANNEL=file
LOG_LEVEL=debug
LOG_MAX_FILES=30