# Application
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:generate_a_unique_application_key_here
APP_URL=https://example.com

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myblog
DB_USERNAME=myblog_user
DB_PASSWORD=change_me
DB_PREFIX=va_
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# SMTP (for password reset, contact forms, etc.)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@myblog.loc
MAIL_FROM_NAME="МойБлог"

# Redis (for rate limiting, cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_FORGOT_PASSWORD=2
RATE_LIMIT_COMMENT=10
RATE_LIMIT_ORDER=5
RATE_LIMIT_CONTACT=5